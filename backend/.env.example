# Arquivo do banco SQLite (relativo à pasta prisma/)
DATABASE_URL="file:./alx.db"
# 0.0.0.0 permite acesso pelo celular no mesmo Wi-Fi
HOST=0.0.0.0
PORT=3000
TZ=America/Sao_Paulo
# Backups automáticos (um por dia, guarda os últimos BACKUP_MANTER).
# Deixe BACKUP_DIR vazio para usar a pasta backups/ do projeto, ou aponte para
# uma pasta do Google Drive, ex.: BACKUP_DIR="C:\Users\voce\Google Drive\ALX-backups"
BACKUP_DIR=
BACKUP_MANTER=30
BACKUP_AUTOMATICO=true
# Pasta das fotos. Vazio = pasta imagens/ do projeto. O backup copia as fotos novas junto.
IMAGENS_DIR=
